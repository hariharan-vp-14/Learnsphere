PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL="mysql://learnsphere_user:learnsphere_password@localhost:3306/learnsphere"

# Frontend URL used for redirects and CORS
CLIENT_URL=http://localhost:5173

# Google OAuth: must match the Google Cloud Console authorized redirect URI exactly
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Email delivery configuration for account verification and password resets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=LearnSphere <your-sender@gmail.com>

# Optional local-only development settings
NODE_ENV=development
DEV_INSTRUCTOR_EMAIL=teacher@gmail.com
DEV_INSTRUCTOR_NAME=Local Instructor
DEV_INSTRUCTOR_PASSWORD=ChangeMe123!
